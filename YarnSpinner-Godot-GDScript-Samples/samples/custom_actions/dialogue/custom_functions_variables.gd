class_name CustomFunctionsVariables
extends YarnInMemoryVariableStorage

enum FoodType {
	NONE = 2140143823,
	APPLE = -1456549808,
	ORANGE = 499495288,
	BLUEBERRY = 2032018643,
}

const _FOOD_TYPE_VALUES := {
	FoodType.NONE: "none",
	FoodType.APPLE: "apple",
	FoodType.ORANGE: "orange",
	FoodType.BLUEBERRY: "blueberry",
}

## The current type of food that Henry wants
