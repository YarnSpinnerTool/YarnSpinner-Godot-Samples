title: Goodbye
position: 12,377
tags: ending
---
// Visited tracking
<<declare $sections_visited = 0>>
<<set $sections_visited = 0>>

<<if visited("Variables")>>
    <<set $sections_visited = $sections_visited + 1>>
<<endif>>
<<if visited("Conditionals")>>
    <<set $sections_visited = $sections_visited + 1>>
<<endif>>
<<if visited("Commands")>>
    <<set $sections_visited = $sections_visited + 1>>
<<endif>>
<<if visited("Functions")>>
    <<set $sections_visited = $sections_visited + 1>>
<<endif>>
<<if visited("Advanced")>>
    <<set $sections_visited = $sections_visited + 1>>
<<endif>>
<<if visited("OnceFeatures")>>
    <<set $sections_visited = $sections_visited + 1>>
<<endif>>

Guide: You visited {$sections_visited} of the 6 sections.

<<if $sections_visited == 6>>
    Guide: You visited all of them.
<<elseif $sections_visited >= 3>>
    Guide: You visited at least half of them.
<<else>>
    Guide: The others are still in the menu if you start again.
<<endif>>

Guide: Basics.yarn has the source for every section.

// Dialogue ends here naturally when there's no more content
