title: Start
position: 65,12
---
<<declare $gold = 50>>
<<declare $initialized = false>>

// Only show intro on first visit
<<if not $initialized>>
    <<set $initialized = true>>
    <<shake 0.3>>
    Merchant: Hello. That shake was the shake command.
<<else>>
    Merchant: Hello again.
<<endif>>

<<jump MainMenu>>
===

title: MainMenu
position: 65,237
---
// Show player status
Merchant: You have {$gold} gold coins.

<<if player_health() < 100>>
    Merchant: You look a bit worn. Your health is only {player_health()}.
<<endif>>

-> Ask about items
    <<jump Shop>>
-> Ask about special services
    <<jump Services>>
-> Leave
    <<jump Farewell>>
===

title: Shop
position: 32,462
---
Merchant: I sell potions and swords.
Merchant: You already have a sword. <<if has_item("sword")>>
Merchant: You only have {$gold} gold, which isn't enough for anything. <<if $gold < 30>>


-> Buy a Health Potion (30 gold) <<if $gold >= 30>>
    <<set $gold = $gold - 30>>
    <<heal 25>>
    Merchant: You drink the potion.
    Merchant: You now have {player_health()} health and {$gold} gold remaining.
    <<jump Shop>>
-> Buy a Sword (50 gold) <<if $gold >= 50 and not has_item("sword")>>
    <<set $gold = $gold - 50>>
    <<give_item "sword">>
    <<shake_and_wait 0.4 0.5>>
    Merchant: Here's your sword. The dialogue waited for that shake to finish.
    Merchant: You have {$gold} gold remaining.
    <<jump Shop>>
-> Back to main menu
    <<jump MainMenu>>
===

title: Services
position: 342,462
---
Merchant: I can also show off some screen effects.

-> Get a dramatic entrance (free)
    Merchant: Here it comes. It costs you 20 health.
    <<fade_out 0.3>>
    <<wait 0.5>>
    <<zoom 1.5 0.3>>
    <<fade_in 0.3>>
    <<shake_and_wait 0.8 1.0>>
    <<heal -20>>
    <<zoom 1.0 0.5>>
    Merchant: How was that?
    <<jump Services>>
-> Flash the screen (free)
    <<flash white 0.3>>
    Merchant: That was the flash command.
    <<jump Services>>
-> Ask for a free map <<if not has_item("map")>>
    <<give_item "map">>
    Merchant: Here's a map. It's now in your inventory.
    <<jump Services>>
-> Back to main menu
    <<jump MainMenu>>
===

title: Farewell
position: 622,462
---
<<if has_item("map")>>
    Merchant: Goodbye. Keep the map.
<<else>>
    Merchant: Goodbye.
<<endif>>

<<fade_out 0.5>>
Merchant: Come back when you have more gold.
<<wait 1.0>>
<<fade_in 0.5>>
===
